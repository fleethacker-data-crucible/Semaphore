      "kind": "kpi",
      "title": "Labor cost",
      "brief": "Total labor cost. Turn red over $5M.",
      "layout": { "x": 3, "y": 0, "w": 3, "h": 2 },
      "binding": { "metrics": ["labor_cost"], "dimensions": [], "filters": [] },
      "behavior": { "onClick": "none", "ignore": [], "thresholds": [{ "metric": "labor_cost", "op": "gt", "value": 5000000, "tone": "bad" }] },
      "status": "ready",
      "notes": []
    },
    {
