      "behavior": { "onClick": "filter-page", "ignore": [], "thresholds": [] },
      "status": "ready",
      "notes": []
    },
    {
      "id": "bar-region",
      "kind": "bar",
      "title": "Labor cost by region",
      "brief": "Labor cost by region. Clicking a bar filters the page.",
      "layout": { "x": 0, "y": 2, "w": 6, "h": 4 },
