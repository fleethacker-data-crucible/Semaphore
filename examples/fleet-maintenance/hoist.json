{
  "version": 1,
  "id": "fleet-maintenance",
  "title": "Fleet maintenance overview",
  "brief": "Maintenance picture for the last 12 months. Leadership wants cost and backlog at a glance, and clicking a region or ship class should filter the whole page.",
