{
  "name": "semaphore",
  "version": "0.4.0",
  "private": true,
  "description": "Semaphore: local-first dashboard intelligence. Drop flags on a hoist, describe them, and Semaphore wires the data.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node -e \"process.getBuiltinModule('node:sqlite') || (console.error('node:sqlite is missing: use Node 22.18 or later'), process.exit(1))\" && node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build": "node web/build.mjs && node web/build-contract.mjs",
    "dev": "node web/build.mjs --watch",
    "size": "node web/size.mjs",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts --trace off"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
